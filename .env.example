# Base URL of the Laravel API (separate repo). Leave unset to use the mock backend.
NEXT_PUBLIC_API_BASE_URL=

# Backend source: "mock" (default in dev) or "live".
# When "mock", lib/api serves in-memory fixtures so the frontend is never blocked on the backend.
NEXT_PUBLIC_API_SOURCE=mock

# Document engine source: "mock" (local registry) or "live" (bedrock-api).
# Independent of NEXT_PUBLIC_API_SOURCE so documents can go live while the rest stays mock.
NEXT_PUBLIC_DOCS_SOURCE=mock

# Public verification portal origin — printed QR codes resolve here.
NEXT_PUBLIC_VERIFY_BASE_URL=https://hub.saharabasetech.com

# Paystack public key for the inline pay button (client portal). Test key in dev.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Public app origin (client portal links). Set to the production domain in prod.
NEXT_PUBLIC_APP_URL=
